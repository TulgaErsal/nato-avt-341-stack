<launch>
  <param name="/use_sim_time" value="false"/>
  <arg name="display" default="rviz"/>
  <arg name="auto_launch_rviz" default="false"/>
  <arg name="use_mpc" default="false" doc="Local planner - Use MPC local planner instead of road centerline constrained splines."/>
  <arg name="scene_file_arg" default="/mavs/data/scenes/forester_scene_less_trees_simple.json" /> 
  <arg name="vehicle_file_arg" default="/mavs/data/vehicles/rp3d_vehicles/mrzr4_tires_low_gear.json" />

  <rosparam file="$(find avt_341)/config/waypoints.yaml" />

  <param name="robot_description" command="cat $(find avt_341)/config/avt_bot.urdf" />

<!-- VEHICLE 1 -->
  <group if="$(eval env('ROS_DISTRO') =='noetic')">
    <node name="v1_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="v1_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='melodic')">
    <node name="v1_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="v1_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='lunar')">
    <node name="v1_robot_state_publisher" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="v1_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='kinetic')">
    <node name="v1_robot_state_publisher" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="v1_joint_states" />
    </node>
  </group>

  <node pkg="tf"  name="v1_static_transform_publisher" type="static_transform_publisher" args="0 0 0 0 0 0 1 map odom 10">

  </node>
  <node name="v1_state_publisher" pkg="avt_341" type="avt_bot_state_publisher_node">
    <remap from="avt_341/odometry" to="avt_341/v1_odometry" />
    <remap from="joint_states" to="v1_joint_states" />
  </node>

<!-- Required on vehicle, not in simulation -->
  <!-- <node name="mrak_broadcaster_node" pkg="mrzr_speed_tuning" type="mrak_broadcaster_node" required="true" output="screen" > -->
  <!--broadcast the mrak speed message -->
  <!-- </node> -->

  <!-- <node name="mrzr_speed_republish_node" pkg="mrzr_speed_tuning" type="mrzr_speed_republish_node" required="true" output="screen" > -->
  <!--republish the mrak speed message as a float64 -->
  <!-- </node> -->

  <!-- Lidar perception algorithms  -->
  <node name="v1_perception_node" pkg="avt_341" type="avt_341_perception_node" required="true" output="screen">
    <remap from="avt_341/points" to="avt_341/v1_points" />
    <remap from="avt_341/odometry" to="avt_341/v1_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v1_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v1_segmentation_grid" />
    <param name="use_elevation" value="false" />
    <param name="slope_threshold" value="2.5" />
    <param name="grid_height" value="120.0" />
    <param name="grid_width" value="120.0" />
    <param name="stitch_lidar_points" value="true"/>
    <param name="filter_highest_lidar" value="false"/>
    <param name="time_register_window" value="0.015" />
    <param name="grid_llx" value="-60.0" />
    <param name="grid_lly" value="-60.0" />
    <param name="grid_res" value="0.25" />
    <param name="overhead_clearance" value="7.0" />
    <param name="warmup_time" value="5.0" />
    <param name="use_registered" value="true" />
    <param name="display" value="$(arg display)" />
    <!-- <param name="grid_dilate" value="false"/>
    <param name="max_point_age" value="0.0"/> -->
  </node>

  <node name="v1_vehicle_control_node" pkg="avt_341" type="avt_341_control_node" required="true" output="screen" >
    <remap from="avt_341/cmd_vel" to="avt_341/v1_cmd_vel" />
    <remap from="avt_341/local_path" to="avt_341/v1_local_path" />
    <remap from="avt_341/odometry" to="avt_341/v1_odometry" />
    <remap from="avt_341/state" to="avt_341/v1_state" />
    <remap from="mrzr_velocity" to="v1_mrzr_velocity" />
    <remap from="avt_341/desired_speed" to="avt_341/v1_desired_speed" />
    <remap from="avt_341/control_next_waypoint" to="avt_341/v1_control_next_waypoint" />

    <param name="vehicle_wheelbase" value="2.72" />
    <param name="vehicle_max_steer_angle_degrees" value="35.0" />
    <param name="steering_coefficient" value="4.5" />
    <param name="throttle_coefficient" value="1.0" />
    <param name="vehicle_speed" value="5.0" />
    <param name="throttle_kp" value="0.1129" />
    <param name="throttle_ki" value="0.0" />
    <param name="throttle_kd" value="0.0435" />
    <param name="max_desired_lateral_g" value="0.25" />
    <param name="time_to_max_brake" value="4.0" />
    <param name="time_to_max_throttle" value="3.0" />
    <param name="use_feed_forward" value="true" />
    <param name="ff_a0" value="0.2134" />
    <param name="ff_a1" value="0.0422" />
    <param name="ff_a2" value="-0.0003" />
  </node>

<!--
  <node name="path_manager_node" pkg="avt_341" type="path_manager_node" required="true" output="screen">
    <param name="wait_period" value="30.0" />
  </node>
  -->

  <node name="v1_global_path_node" pkg="avt_341" type="avt_341_global_path_node" required="true" output="screen" >
    <remap from="avt_341/global_path" to="avt_341/v1_global_path" />
    <remap from="avt_341/waypoints" to="avt_341/v1_waypoints" />
    <remap from="avt_341/current_waypoint" to="avt_341/v1_current_waypoint" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/v1_distance_to_current_waypoint" />
    <remap from="avt_341/odometry" to="avt_341/v1_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v1_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v1_segmentation_grid" />
    <remap from="avt_341/new_waypoints" to="avt_341/v1_new_waypoints" />
    <remap from="avt_341/state" to="avt_341/v1_state" />

    <param name="goal_dist" value="8.0" />
    <param name="global_lookahead" value="75.0" />
    <param name="shutdown_behavior" value="2" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="v1_local_planner_node" pkg="avt_341" type="avt_341_local_planner_node" output="screen" required="true" if="$(eval not arg('use_mpc'))">
    <remap from="avt_341/local_path" to="avt_341/v1_local_path" />
    <remap from="avt_341/odometry" to="avt_341/v1_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v1_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v1_segmentation_grid" />
    <remap from="avt_341/global_path" to="avt_341/v1_global_path" />
    <remap from="avt_341/waypoints" to="avt_341/v1_waypoints" />

    <param name="path_look_ahead" value="20.0" />
    <param name="vehicle_width" value="3.0" />
    <param name="use_global_path" value="false" />
    <param name="num_paths" value="31" />
    <param name="max_steer_angle" value="0.4" />
    <param name="output_path_step" value="0.5" />
    <param name="path_integration_step" value="0.25" />
    <param name="dilation_factor" value="3" />
    <param name="w_c" value="0.0" />
    <param name="w_s" value="0.95" />
    <param name="w_d" value="0.0" />
    <param name="w_r" value="0.05" />
    <param name="rate" value="50.0" />
    <param name="trim_path" value="true" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="v1_mavs_vehcicle_node" pkg="mavs_ros" type="mavs_vehicle_node" output="screen" required="true" >
    <remap from= "mavs_ros/cmd_vel" to="avt_341/v1_cmd_vel"/> 
    <remap from= "mavs_ros/odometry" to="avt_341/v1_odometry"/> 

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "debug_camera" value="true" />
    <param name= "Initial_X_Position" value = "-50.0"/>
    <param name= "Initial_Y_Position" value = "0.0"/>
    <param name= "Initial_Heading" value = "0.0"/>
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "soil_strength" value = "250"/> 
    <param name= "surface_type" value = "dry"/>  
    <param name= "publish_imu" value="true" />
    <param name= "imu_input_file" value = "$(find mavs_ros)/config/mavs_imu_inputs.json" />
    <param name= "use_human_driver" value="false" />
  </node>

  <node name="v1_mavs_sensors_node" pkg="mavs_ros" type="mavs_sensors_node" output="screen" required="true" >
    <remap from= "mavs_ros/point_cloud2" to="avt_341/v1_points"/> 

    <param name= "use_lidar" value="true" />
    <param name= "display_lidar" value="true" />
    <param name= "register_lidar" value="true" />
    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "lidar_type" value = "OS1"/>
    <param name= "blanking_dist" value="5.0" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
  </node>
<!-- END VEHICLE 1 -->

<!-- VEHICLE 2 -->
  <group if="$(eval env('ROS_DISTRO') =='noetic')">
    <node name="v2_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="v2_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='melodic')">
    <node name="v2_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="v2_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='lunar')">
    <node name="v2_robot_state_publisher" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="v2_joint_states" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='kinetic')">
    <node name="v2_robot_state_publisher" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="v2_joint_states" />
    </node>
  </group>

  <node pkg="tf"  name="v2_static_transform_publisher" type="static_transform_publisher" args="0 0 0 0 0 0 1 map odom 10">

  </node>
  <node name="v2_state_publisher" pkg="avt_341" type="avt_bot_state_publisher_node">
    <remap from="avt_341/odometry" to="avt_341/v2_odometry" />
    <remap from="joint_states" to="v2_joint_states" />
  </node>

<!-- Required on vehicle, not in simulation -->
  <!-- <node name="mrak_broadcaster_node" pkg="mrzr_speed_tuning" type="mrak_broadcaster_node" required="true" output="screen" > -->
  <!--broadcast the mrak speed message -->
  <!-- </node> -->

  <!-- <node name="mrzr_speed_republish_node" pkg="mrzr_speed_tuning" type="mrzr_speed_republish_node" required="true" output="screen" > -->
  <!--republish the mrak speed message as a float64 -->
  <!-- </node> -->

  <!-- Lidar perception algorithms  -->
  <node name="v2_perception_node" pkg="avt_341" type="avt_341_perception_node" required="true" output="screen">
    <remap from="avt_341/points" to="avt_341/v2_points" />
    <remap from="avt_341/odometry" to="avt_341/v2_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v2_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v2_segmentation_grid" />

    <param name="use_elevation" value="false" />
    <param name="slope_threshold" value="2.5" />
    <param name="grid_height" value="120.0" />
    <param name="grid_width" value="120.0" />
    <param name="stitch_lidar_points" value="true"/>
    <param name="filter_highest_lidar" value="false"/>
    <param name="time_register_window" value="0.015" />
    <param name="grid_llx" value="-60.0" />
    <param name="grid_lly" value="-60.0" />
    <param name="grid_res" value="0.25" />
    <param name="overhead_clearance" value="7.0" />
    <param name="warmup_time" value="5.0" />
    <param name="use_registered" value="true" />
    <param name="display" value="$(arg display)" />
    <!-- <param name="grid_dilate" value="false"/>
    <param name="max_point_age" value="0.0"/> -->
  </node>

  <node name="v2_vehicle_control_node" pkg="avt_341" type="avt_341_control_node" required="true" output="screen" >
    <remap from="avt_341/cmd_vel" to="avt_341/v2_cmd_vel" />
    <remap from="avt_341/local_path" to="avt_341/v2_local_path" />
    <remap from="avt_341/odometry" to="avt_341/v2_odometry" />
    <remap from="avt_341/state" to="avt_341/v2_state" />
    <remap from="mrzr_velocity" to="v2_mrzr_velocity" />
    <remap from="avt_341/desired_speed" to="avt_341/v2_desired_speed" />
    <remap from="avt_341/control_next_waypoint" to="avt_341/v2_control_next_waypoint" />

    <param name="vehicle_wheelbase" value="2.72" />
    <param name="vehicle_max_steer_angle_degrees" value="35.0" />
    <param name="steering_coefficient" value="4.5" />
    <param name="throttle_coefficient" value="1.0" />
    <param name="vehicle_speed" value="5.0" />
    <param name="throttle_kp" value="0.1129" />
    <param name="throttle_ki" value="0.0" />
    <param name="throttle_kd" value="0.0435" />
    <param name="max_desired_lateral_g" value="0.25" />
    <param name="time_to_max_brake" value="4.0" />
    <param name="time_to_max_throttle" value="3.0" />
    <param name="use_feed_forward" value="true" />
    <param name="ff_a0" value="0.2134" />
    <param name="ff_a1" value="0.0422" />
    <param name="ff_a2" value="-0.0003" />
  </node>

<!--
  <node name="path_manager_node" pkg="avt_341" type="path_manager_node" required="true" output="screen">
    <param name="wait_period" value="30.0" />
  </node>
  -->

  <node name="v2_global_path_node" pkg="avt_341" type="avt_341_global_path_node" required="true" output="screen" >
    <remap from="avt_341/global_path" to="avt_341/v2_global_path" />
    <remap from="avt_341/waypoints" to="avt_341/v2_waypoints" />
    <remap from="avt_341/current_waypoint" to="avt_341/v2_current_waypoint" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/v2_distance_to_current_waypoint" />
    <remap from="avt_341/odometry" to="avt_341/v2_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v2_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v2_segmentation_grid" />
    <remap from="avt_341/new_waypoints" to="avt_341/v2_new_waypoints" />
    <remap from="avt_341/state" to="avt_341/v2_state" />

    <param name="goal_dist" value="8.0" />
    <param name="global_lookahead" value="75.0" />
    <param name="shutdown_behavior" value="2" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="v2_local_planner_node" pkg="avt_341" type="avt_341_local_planner_node" output="screen" required="true" if="$(eval not arg('use_mpc'))">
    <remap from="avt_341/local_path" to="avt_341/v2_local_path" />
    <remap from="avt_341/odometry" to="avt_341/v2_odometry" />
    <remap from="avt_341/occupancy_grid" to="avt_341/v2_occupancy_grid" />
    <remap from="avt_341/segmentation_grid" to="avt_341/v2_segmentation_grid" />
    <remap from="avt_341/global_path" to="avt_341/v2_global_path" />
    <remap from="avt_341/waypoints" to="avt_341/v2_waypoints" />

    <param name="path_look_ahead" value="20.0" />
    <param name="vehicle_width" value="3.0" />
    <param name="use_global_path" value="false" />
    <param name="num_paths" value="31" />
    <param name="max_steer_angle" value="0.4" />
    <param name="output_path_step" value="0.5" />
    <param name="path_integration_step" value="0.25" />
    <param name="dilation_factor" value="3" />
    <param name="w_c" value="0.0" />
    <param name="w_s" value="0.95" />
    <param name="w_d" value="0.0" />
    <param name="w_r" value="0.05" />
    <param name="rate" value="50.0" />
    <param name="trim_path" value="true" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="v2_mavs_vehcicle_node" pkg="mavs_ros" type="mavs_vehicle_node" output="screen" required="true" >
    <remap from= "mavs_ros/cmd_vel" to="avt_341/v2_cmd_vel"/> 
    <remap from= "mavs_ros/odometry" to="avt_341/v2_odometry"/> 

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "debug_camera" value="true" />
    <param name= "Initial_X_Position" value = "-50.0"/>
    <param name= "Initial_Y_Position" value = "10.0"/>
    <param name= "Initial_Heading" value = "0.0"/>
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "soil_strength" value = "250"/> 
    <param name= "surface_type" value = "dry"/>  
    <param name= "publish_imu" value="true" />
    <param name= "imu_input_file" value = "$(find mavs_ros)/config/mavs_imu_inputs.json" />
    <param name= "use_human_driver" value="false" />
  </node>

  <node name="v2_mavs_sensors_node" pkg="mavs_ros" type="mavs_sensors_node" output="screen" required="true" >
    <remap from= "mavs_ros/point_cloud2" to="avt_341/v2_points"/> 

    <param name= "use_lidar" value="true" />
    <param name= "display_lidar" value="true" />
    <param name= "register_lidar" value="true" />
    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "lidar_type" value = "OS1"/>
    <param name= "blanking_dist" value="5.0" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
  </node>
<!-- END VEHICLE 2 -->

  <group if="$(eval arg('display') == 'rviz' and arg('auto_launch_rviz'))">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find avt_341)/rviz/avt_341.rviz" />
  </group>

</launch>
