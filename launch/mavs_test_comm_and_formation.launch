<launch>
  <param name="/use_sim_time" value="false"/>
  <arg name="display" default="rviz"/>
  <arg name="auto_launch_rviz" default="false"/>
  <arg name="use_mpc" default="false" doc="Local planner - Use MPC local planner instead of road centerline constrained splines."/>
  <arg name="scene_file_arg" default="/mavs/data/scenes/forester_scene_less_trees_simple.json" /> 
  <arg name="vehicle_file_arg" default="/mavs/data/vehicles/rp3d_vehicles/mrzr4_tires_low_gear.json" />

  <rosparam file="$(find avt_341)/config/waypoints.yaml" />

  <param name="robot_description" command="cat $(find avt_341)/config/avt_bot.urdf" />

<!-- VEHICLE 1 -->
  <group if="$(eval env('ROS_DISTRO') =='noetic')">
    <node name="robot_state_publisher001" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="joint_states001" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='melodic')">
    <node name="robot_state_publisher001" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="joint_states001" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='lunar')">
    <node name="robot_state_publisher001" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="joint_states001" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='kinetic')">
    <node name="robot_state_publisher001" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="joint_states001" />
    </node>
  </group>

  <node pkg="tf"  name="static_transform_publisher001" type="static_transform_publisher" args="0 0 0 0 0 0 1 map odom 10">

  </node>
  <node name="state_publisher001" pkg="avt_341" type="avt_bot_state_publisher_node">
    <remap from="avt_341/odometry" to="avt_341/odometry001" />
    <remap from="joint_states" to="joint_states001" />
  </node>

<!-- Required on vehicle, not in simulation -->
  <!-- <node name="mrak_broadcaster_node" pkg="mrzr_speed_tuning" type="mrak_broadcaster_node" required="true" output="screen" > -->
  <!--broadcast the mrak speed message -->
  <!-- </node> -->

  <!-- <node name="mrzr_speed_republish_node" pkg="mrzr_speed_tuning" type="mrzr_speed_republish_node" required="true" output="screen" > -->
  <!--republish the mrak speed message as a float64 -->
  <!-- </node> -->

  <!-- Formation algorithms  -->
  <node name="formation_control_node001" pkg="avt_341" type="avt_341_formation_control_node" required="true" output="screen" >
    <remap from="avt_341/odometry" to="avt_341/odometry001"/> 
    <remap from="avt_341/follower_status" to="avt_341/status001"/> 
    <remap from="avt_341/global_path" to="avt_341/global_path001"/>
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed001"/> 
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry001"/>

    <param name="is_leader" value="true" />
    <param name="name" value="AGV1"/>
  </node>

  <!-- Communications algorithms  -->
  <node name="comm_node001" pkg="avt_341" type="avt_341_comm_node" required="true" output="screen">
    <remap from="avt_341/comm_messages" to="avt_341/comm_messages001"/>
    <remap from="avt_341/recv_comms" to="avt_341/recv_comms001"/>
    <remap from="avt_341/follower_status" to="avt_341/status001"/>
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry001"/>
    <remap from="avt_341/veh1_odometry" to="avt_341/odometry001" />
    <remap from="avt_341/follower1_odometry" to="avt_341/odometry002" />
    <remap from="avt_341/follower2_odometry" to="avt_341/odometry003" />
    <remap from="avt_341/follower3_odometry" to="avt_341/odometry004" />

    <param name="host" value="localhost"/>
    <param name="port" value="9000"/>
    <param name="name" value="AGV1"/>
    <param name="scale" value="20.0"/>
  </node>

  <!-- Lidar perception algorithms  -->
  <node name="perception_node001" pkg="avt_341" type="avt_341_perception_node" required="true" output="screen">
    <remap from="avt_341/points" to="avt_341/points001" />
    <remap from="avt_341/odometry" to="avt_341/odometry001" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid001" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid001" />

    <param name="use_elevation" value="false" />
    <param name="slope_threshold" value="2.5" />
    <param name="grid_height" value="120.0" />
    <param name="grid_width" value="120.0" />
    <param name="stitch_lidar_points" value="true"/>
    <param name="filter_highest_lidar" value="false"/>
    <param name="time_register_window" value="0.015" />
    <param name="grid_llx" value="-60.0" />
    <param name="grid_lly" value="-60.0" />
    <param name="grid_res" value="0.25" />
    <param name="overhead_clearance" value="7.0" />
    <param name="warmup_time" value="5.0" />
    <param name="use_registered" value="true" />
    <param name="display" value="$(arg display)" />
    <!-- <param name="grid_dilate" value="false"/>
    <param name="max_point_age" value="0.0"/> -->
  </node>

  <node name="vehicle_control_node001" pkg="avt_341" type="avt_341_control_node" required="true" output="screen" >
    <remap from="avt_341/cmd_vel" to="avt_341/cmd_vel001" />
    <remap from="avt_341/local_path" to="avt_341/local_path001" />
    <remap from="avt_341/odometry" to="avt_341/odometry001" />
    <remap from="avt_341/state" to="avt_341/state001" />
    <remap from="mrzr_velocity" to="mrzr_velocity001" />
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed001" />
    <remap from="avt_341/control_next_waypoint" to="avt_341/control_next_waypoint001" />

    <param name="vehicle_wheelbase" value="2.72" />
    <param name="vehicle_max_steer_angle_degrees" value="35.0" />
    <param name="steering_coefficient" value="4.5" />
    <param name="throttle_coefficient" value="1.0" />
    <param name="vehicle_speed" value="5.0" />
    <param name="throttle_kp" value="0.1129" />
    <param name="throttle_ki" value="0.0" />
    <param name="throttle_kd" value="0.0435" />
    <param name="max_desired_lateral_g" value="0.25" />
    <param name="time_to_max_brake" value="4.0" />
    <param name="time_to_max_throttle" value="3.0" />
    <param name="use_feed_forward" value="true" />
    <param name="ff_a0" value="0.2134" />
    <param name="ff_a1" value="0.0422" />
    <param name="ff_a2" value="-0.0003" />
  </node>

<!--
  <node name="path_manager_node" pkg="avt_341" type="path_manager_node" required="true" output="screen">
    <param name="wait_period" value="30.0" />
  </node>
  -->

  <node name="global_path_node001" pkg="avt_341" type="avt_341_global_path_node" required="true" output="screen" >
    <remap from="avt_341/global_path" to="avt_341/global_path001" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints001" />
    <remap from="avt_341/current_waypoint" to="avt_341/current_waypoint001" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/distance_to_current_waypoint001" />
    <remap from="avt_341/odometry" to="avt_341/odometry001" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid001" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid001" />
    <remap from="avt_341/new_waypoints" to="avt_341/new_waypoints001" />
    <remap from="avt_341/state" to="avt_341/state001" />

    <param name="goal_dist" value="8.0" />
    <param name="global_lookahead" value="75.0" />
    <param name="shutdown_behavior" value="2" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="local_planner_node001" pkg="avt_341" type="avt_341_local_planner_node" output="screen" required="true" if="$(eval not arg('use_mpc'))">
    <remap from="avt_341/local_path" to="avt_341/local_path001" />
    <remap from="avt_341/odometry" to="avt_341/odometry001" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid001" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid001" />
    <remap from="avt_341/global_path" to="avt_341/global_path001" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints001" />
    <remap from="avt_341/candidate_paths" to="avt_341/candidate_paths001" />

    <param name="path_look_ahead" value="20.0" />
    <param name="vehicle_width" value="3.0" />
    <param name="use_global_path" value="false" />
    <param name="num_paths" value="31" />
    <param name="max_steer_angle" value="0.4" />
    <param name="output_path_step" value="0.5" />
    <param name="path_integration_step" value="0.25" />
    <param name="dilation_factor" value="3" />
    <param name="w_c" value="0.0" />
    <param name="w_s" value="0.95" />
    <param name="w_d" value="0.0" />
    <param name="w_r" value="0.05" />
    <param name="rate" value="50.0" />
    <param name="trim_path" value="true" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="mavs_vehicle_node001" pkg="mavs_ros" type="mavs_vehicle_node" output="screen" required="true" >
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel001"/> 
    <remap from= "mavs_ros/odometry" to="avt_341/odometry001" />
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true001"/>
    <remap from= "mavs_ros/anim_poses" to="mavs_ros/anim_poses001"/>  

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "debug_camera" value="false" />
    <param name= "Initial_X_Position" value = "-75.0"/>
    <param name= "Initial_Y_Position" value = "0.0"/>
    <param name= "Initial_Heading" value = "0.0"/>
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "soil_strength" value = "250"/> 
    <param name= "surface_type" value = "dry"/>  
    <param name= "publish_imu" value="true" />
    <param name= "imu_input_file" value = "$(find mavs_ros)/config/mavs_imu_inputs.json" />
    <param name= "use_human_driver" value="false" />
    <param name= "vehicle_id" value="vehicle1" />
  </node>

  <node name="mavs_sensors_node001" pkg="mavs_ros" type="mavs_sensors_node" output="screen" required="true" >
    <remap from= "mavs_ros/point_cloud2" to="avt_341/points001"/> 
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true001" />

    <param name= "use_lidar" value="true" />
    <param name= "display_lidar" value="true" />
    <param name= "register_lidar" value="true" />
    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "lidar_type" value = "OS1"/>
    <param name= "blanking_dist" value="5.0" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "num_vehicles" value="2" />
  </node>

  <node name="mavs_camera_node001" pkg="mavs_ros" type="mavs_camera_node" output="screen" required="true" >
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true001"/>  
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel001"/>  

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "display_image" value="true" />
    <param name= "num_vehicles" value="2" />
    <param name= "off_x" value="-10.0" />
    <param name= "off_y" value="0.0" />
    <param name= "off_z" value="2.5" />
    <param name= "num_horizontal_pix" value="384" />
    <param name= "num_vertical_pix" value="256" />
    <param name= "horizontal_pixdim" value="0.00525" />
    <param name= "vertical_pixdim" value="0.0035" />
    <param name= "focal_length" value="0.0035" />
    <param name= "publish_driving_commands" value="false" />
  </node>
<!-- END VEHICLE 1 -->

<!-- VEHICLE 2 -->
  <group if="$(eval env('ROS_DISTRO') =='noetic')">
    <node name="robot_state_publisher002" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="joint_states002" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='melodic')">
    <node name="robot_state_publisher002" pkg="robot_state_publisher" type="robot_state_publisher">
      <remap from="joint_states" to="joint_states002" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='lunar')">
    <node name="robot_state_publisher002" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="joint_states002" />
    </node>
  </group>
  <group if="$(eval env('ROS_DISTRO') =='kinetic')">
    <node name="robot_state_publisher002" pkg="robot_state_publisher" type="state_publisher">
      <remap from="joint_states" to="joint_states002" />
    </node>
  </group>

  <node pkg="tf"  name="static_transform_publisher002" type="static_transform_publisher" args="0 0 0 0 0 0 1 map odom 10">

  </node>
  <node name="state_publisher002" pkg="avt_341" type="avt_bot_state_publisher_node">
    <remap from="avt_341/odometry" to="avt_341/odometry002" />
    <remap from="joint_states" to="joint_states002" />
  </node>

<!-- Required on vehicle, not in simulation -->
  <!-- <node name="mrak_broadcaster_node" pkg="mrzr_speed_tuning" type="mrak_broadcaster_node" required="true" output="screen" > -->
  <!--broadcast the mrak speed message -->
  <!-- </node> -->

  <!-- <node name="mrzr_speed_republish_node" pkg="mrzr_speed_tuning" type="mrzr_speed_republish_node" required="true" output="screen" > -->
  <!--republish the mrak speed message as a float64 -->
  <!-- </node> -->

 <!-- Formation algorithms  -->
  <node name="formation_control_node002" pkg="avt_341" type="avt_341_formation_control_node" required="true" output="screen" >
    <remap from="avt_341/odometry" to="avt_341/odometry002"/> 
    <remap from="avt_341/follower_status" to="avt_341/status002"/> 
    <remap from="avt_341/global_path" to="avt_341/global_path002"/>
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed002"/> 
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry002"/>

    <param name="is_leader" value="true" />
    <param name="name" value="AGV2"/>
  </node>

  <!-- Communications algorithms  -->
  <node name="comm_node002" pkg="avt_341" type="avt_341_comm_node" required="true" output="screen">
    <remap from="avt_341/comm_messages" to="avt_341/comm_messages002"/>
    <remap from="avt_341/recv_comms" to="avt_341/recv_comms002"/>
    <remap from="avt_341/follower_status" to="avt_341/status002"/>
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry002"/>
    <remap from="avt_341/veh1_odometry" to="avt_341/odometry001" />
    <remap from="avt_341/follower1_odometry" to="avt_341/odometry002" />
    <remap from="avt_341/follower2_odometry" to="avt_341/odometry003" />
    <remap from="avt_341/follower3_odometry" to="avt_341/odometry004" />
    
    <param name="host" value="localhost"/>
    <param name="port" value="9000"/>
    <param name="name" value="AGV2"/>
    <param name="scale" value="20.0"/>
  </node>

  <!-- Lidar perception algorithms  -->
  <node name="perception_node002" pkg="avt_341" type="avt_341_perception_node" required="true" output="screen">
    <remap from="avt_341/points" to="avt_341/points002" />
    <remap from="avt_341/odometry" to="avt_341/odometry002" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid002" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid002" />

    <param name="use_elevation" value="false" />
    <param name="slope_threshold" value="2.5" />
    <param name="grid_height" value="120.0" />
    <param name="grid_width" value="120.0" />
    <param name="stitch_lidar_points" value="true"/>
    <param name="filter_highest_lidar" value="false"/>
    <param name="time_register_window" value="0.015" />
    <param name="grid_llx" value="-60.0" />
    <param name="grid_lly" value="-60.0" />
    <param name="grid_res" value="0.25" />
    <param name="overhead_clearance" value="7.0" />
    <param name="warmup_time" value="5.0" />
    <param name="use_registered" value="true" />
    <param name="display" value="$(arg display)" />
    <!-- <param name="grid_dilate" value="false"/>
    <param name="max_point_age" value="0.0"/> -->
  </node>

  <node name="vehicle_control_node002" pkg="avt_341" type="avt_341_control_node" required="true" output="screen" >
    <remap from="avt_341/cmd_vel" to="avt_341/cmd_vel002" />
    <remap from="avt_341/local_path" to="avt_341/local_path002" />
    <remap from="avt_341/odometry" to="avt_341/odometry002" />
    <remap from="avt_341/state" to="avt_341/state002" />
    <remap from="mrzr_velocity" to="mrzr_velocity002" />
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed002" />
    <remap from="avt_341/control_next_waypoint" to="avt_341/control_next_waypoint002" />

    <param name="vehicle_wheelbase" value="2.72" />
    <param name="vehicle_max_steer_angle_degrees" value="35.0" />
    <param name="steering_coefficient" value="4.5" />
    <param name="throttle_coefficient" value="1.0" />
    <param name="vehicle_speed" value="5.0" />
    <param name="throttle_kp" value="0.1129" />
    <param name="throttle_ki" value="0.0" />
    <param name="throttle_kd" value="0.0435" />
    <param name="max_desired_lateral_g" value="0.25" />
    <param name="time_to_max_brake" value="4.0" />
    <param name="time_to_max_throttle" value="3.0" />
    <param name="use_feed_forward" value="true" />
    <param name="ff_a0" value="0.2134" />
    <param name="ff_a1" value="0.0422" />
    <param name="ff_a2" value="-0.0003" />
  </node>

<!--
  <node name="path_manager_node" pkg="avt_341" type="path_manager_node" required="true" output="screen">
    <param name="wait_period" value="30.0" />
  </node>
  -->

  <node name="global_path_node002" pkg="avt_341" type="avt_341_global_path_node" required="true" output="screen" >
    <remap from="avt_341/global_path" to="avt_341/global_path002" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints002" />
    <remap from="avt_341/current_waypoint" to="avt_341/current_waypoint002" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/distance_to_current_waypoint002" />
    <remap from="avt_341/odometry" to="avt_341/odometry002" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid002" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid002" />
    <remap from="avt_341/new_waypoints" to="avt_341/new_waypoints002" />
    <remap from="avt_341/state" to="avt_341/state002" />

    <param name="goal_dist" value="8.0" />
    <param name="global_lookahead" value="75.0" />
    <param name="shutdown_behavior" value="2" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="local_planner_node002" pkg="avt_341" type="avt_341_local_planner_node" output="screen" required="true" if="$(eval not arg('use_mpc'))">
    <remap from="avt_341/local_path" to="avt_341/local_path002" />
    <remap from="avt_341/odometry" to="avt_341/odometry002" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid002" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid002" />
    <remap from="avt_341/global_path" to="avt_341/global_path002" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints002" />
    <remap from="avt_341/candidate_paths" to="avt_341/candidate_paths002" />

    <param name="path_look_ahead" value="20.0" />
    <param name="vehicle_width" value="3.0" />
    <param name="use_global_path" value="false" />
    <param name="num_paths" value="31" />
    <param name="max_steer_angle" value="0.4" />
    <param name="output_path_step" value="0.5" />
    <param name="path_integration_step" value="0.25" />
    <param name="dilation_factor" value="3" />
    <param name="w_c" value="0.0" />
    <param name="w_s" value="0.95" />
    <param name="w_d" value="0.0" />
    <param name="w_r" value="0.05" />
    <param name="rate" value="50.0" />
    <param name="trim_path" value="true" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="mavs_vehicle_node002" pkg="mavs_ros" type="mavs_vehicle_node" output="screen" required="true" >
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel002"/> 
    <remap from= "mavs_ros/odometry" to="avt_341/odometry002" />
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true002"/> 
    <remap from= "mavs_ros/anim_poses" to="mavs_ros/anim_poses002"/> 

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "debug_camera" value="false" />
    <param name= "Initial_X_Position" value = "-75.0"/>
    <param name= "Initial_Y_Position" value = "10.0"/>
    <param name= "Initial_Heading" value = "0.0"/>
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "soil_strength" value = "250"/> 
    <param name= "surface_type" value = "dry"/>  
    <param name= "publish_imu" value="true" />
    <param name= "imu_input_file" value = "$(find mavs_ros)/config/mavs_imu_inputs.json" />
    <param name= "use_human_driver" value="false" />
    <param name= "vehicle_id" value="vehicle2" />
  </node>

  <node name="mavs_sensors_node002" pkg="mavs_ros" type="mavs_sensors_node" output="screen" required="true" >
    <remap from= "mavs_ros/point_cloud2" to="avt_341/points002"/> 
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true002" />

    <param name= "use_lidar" value="true" />
    <param name= "display_lidar" value="true" />
    <param name= "register_lidar" value="true" />
    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "lidar_type" value = "OS1"/>
    <param name= "blanking_dist" value="5.0" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name="num_vehicles" value="2" />
  </node>

  
  <node name="mavs_camera_node002" pkg="mavs_ros" type="mavs_camera_node" output="screen" required="true" >
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true002"/>  
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel002"/>  

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "display_image" value="true" />
    <param name= "num_vehicles" value="2" />
    <param name= "off_x" value="-10.0" />
    <param name= "off_y" value="0.0" />
    <param name= "off_z" value="2.5" />
    <param name= "num_horizontal_pix" value="384" />
    <param name= "num_vertical_pix" value="256" />
    <param name= "horizontal_pixdim" value="0.00525" />
    <param name= "vertical_pixdim" value="0.0035" />
    <param name= "focal_length" value="0.0035" />
    <param name= "publish_driving_commands" value="false" />
  </node>
<!-- END VEHICLE 2 -->

  <group if="$(eval arg('display') == 'rviz' and arg('auto_launch_rviz'))">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find avt_341)/rviz/avt_341.rviz" />
  </group>

</launch>
