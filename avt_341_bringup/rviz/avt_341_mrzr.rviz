Panels:
  - Class: rviz_common/Displays
    Help Height: 81
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1/Tree1
        - /Navigation1/Global Planner1
        - /Overlays1/Mission Points1
      Splitter Ratio: 0.5353535413742065
    Tree Height: 340
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
      - /Set Nav Goal1
      - /Set Formation1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: avt_341_rviz_plugins/Mission Command
    Name: Mission Command
  - Class: avt_341_rviz_plugins/AVT-341 Autonomy Stack
    Name: AVT-341 Autonomy Stack
    compute_threshold: 0.800000011920929
    compute_topics:
      - expected_hz: 30
        topic: avt_341/odometry
    topic_config:
      Command Velocity: avt_341/cmd_vel
      Desired Speed: avt_341/desired_speed
      Nav State: avt_341/state
      Odometry: avt_341/odometry
      Task Change: avt_341/task_change
      Tracker State: avt_341/tracker/state
    vehicle_colors:
      - color: 2
        id: feda
      - color: 0
        id: mrzr
      - color: 1
        id: mrzr2
    vehicles:
      - mrzr
      - mrzr2
      - feda
  - Class: avt_341_rviz_plugins/Map Markers
    Name: Map Markers
    Topic: /avt_341/map_markers_change
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 15
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_common/Group
          Displays:
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: z
              Class: rviz_default_plugins/PointCloud2
              Color: 255; 255; 255
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 27.665468215942383
              Min Color: 0; 0; 0
              Min Intensity: -26.889726638793945
              Name: Ouster Points
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 1.5
              Size (m): 0.009999999776482582
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Value: /ouster/points
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz_default_plugins/PointCloud2
              Color: 0; 255; 0
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Max Intensity: 4096
              Min Color: 0; 0; 0
              Min Intensity: 0
              Name: Obstacle Points
              Position Transformer: XYZ
              Selectable: true
              Size (Pixels): 4
              Size (m): 0.009999999776482582
              Style: Points
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /avt_341/lidar_detector/cloud_clusters
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
          Enabled: true
          Name: Lidar
        - Class: rviz_common/Group
          Displays:
            - Alpha: 0.699999988079071
              Class: rviz_default_plugins/Map
              Color Scheme: map
              Draw Behind: false
              Enabled: true
              Name: Local Grid
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/occupancy_grid
              Update Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/occupancy_grid_updates
              Use Timestamp: false
              Value: true
            - Alpha: 0.699999988079071
              Class: rviz_default_plugins/Map
              Color Scheme: map
              Draw Behind: false
              Enabled: true
              Name: Global Grid
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/occupancy_grid_low_res
              Update Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/occupancy_grid_low_res_updates
              Use Timestamp: false
              Value: true
          Enabled: true
          Name: Mapping
        - Class: rviz_common/Group
          Displays:
            - Alpha: 0.699999988079071
              Class: rviz_default_plugins/Map
              Color Scheme: map
              Draw Behind: false
              Enabled: false
              Name: Segmentation Grid
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/local_grid
              Update Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/local_grid_updates
              Use Timestamp: false
              Value: false
          Enabled: true
          Name: Terrain Segmentation
      Enabled: true
      Name: Perception
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_common/Group
          Displays:
            - Alpha: 1
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 25; 255; 0
              Enabled: true
              Head Diameter: 0.30000001192092896
              Head Length: 0.20000000298023224
              Length: 0.30000001192092896
              Line Style: Billboards
              Line Width: 0.5
              Name: Planned Path
              Offset:
                X: 0
                Y: 0
                Z: 0.10000000149011612
              Pose Color: 255; 85; 255
              Pose Style: None
              Radius: 0.029999999329447746
              Shaft Diameter: 0.10000000149011612
              Shaft Length: 0.10000000149011612
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/local_path
              Value: true
            - Class: rviz_default_plugins/MarkerArray
              Enabled: true
              Name: Obstacle Clusters
              Namespaces:
                {}
              Topic:
                Depth: 5
                Durability Policy: Volatile
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/obstacle_markers
              Value: true
            - Alpha: 1
              Class: rviz_default_plugins/PointStamped
              Color: 204; 41; 204
              Enabled: true
              History Length: 1
              Name: Goal
              Radius: 1
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/mpc_goalPoint
              Value: true
          Enabled: true
          Name: MPC
        - Class: rviz_common/Group
          Displays:
            - Alpha: 1
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 255; 170; 0
              Enabled: true
              Head Diameter: 0.30000001192092896
              Head Length: 0.20000000298023224
              Length: 0.30000001192092896
              Line Style: Billboards
              Line Width: 0.5
              Name: Global Path
              Offset:
                X: 0
                Y: 0
                Z: 0
              Pose Color: 255; 85; 255
              Pose Style: None
              Radius: 0.029999999329447746
              Shaft Diameter: 0.10000000149011612
              Shaft Length: 0.10000000149011612
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/global_path
              Value: true
            - Alpha: 0
              Buffer Length: 1
              Class: rviz_default_plugins/Path
              Color: 255; 255; 255
              Enabled: false
              Head Diameter: 0
              Head Length: 2
              Length: 0.30000001192092896
              Line Style: Billboards
              Line Width: 0.0010000000474974513
              Name: Waypoints
              Offset:
                X: 0
                Y: 0
                Z: 0
              Pose Color: 255; 255; 255
              Pose Style: Arrows
              Radius: 0.029999999329447746
              Shaft Diameter: 2
              Shaft Length: 2
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/waypoints
              Value: false
            - Class: avt_341_rviz_plugins/NavGoalSequence
              Enabled: true
              Name: NavGoalSequence
              Pose Arrow:
                Alpha: 1
                Color: 255; 255; 255
                Head Length: 0.5
                Head Radius: 1
                Shaft Length: 1
                Shaft Radius: 0.5
              Threshold Region:
                Circle Color: 255; 255; 255
                Circle Segments: 64
                Circle Thickness: 0.10000000149011612
                Fill Alpha: 0.10000000149011612
                Fill Color: 0; 204; 0
              Topic:
                Depth: 5
                Durability Policy: Volatile
                Filter size: 10
                History Policy: Keep Last
                Reliability Policy: Reliable
                Value: /mrzr/avt_341/new_waypoints
              Value: true
          Enabled: true
          Name: Global Planner
      Enabled: true
      Name: Navigation
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 3
          Name: Robot Frame
          Radius: 0.30000001192092896
          Reference Frame: mrzr/base_link
          Value: true
      Enabled: true
      Name: Localization
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Circle Segments: 64
          Circle Thickness: 0.30000001192092896
          Class: avt_341_rviz_plugins/MapMarkerList
          Color: 0; 0; 0
          Enabled: true
          Name: Mission Points
          Radius: 2
          Text Scale: 1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /avt_341/map_markers_change
          Value: true
        - Alpha: 1
          Class: avt_341_rviz_plugins/StaticMapImage
          Draw Behind: true
          Enabled: true
          Frame: map
          Image File: package://mrzr_avt_341_integration/config/NATO_Area_0025m.png
          Interpolation: Linear
          Name: Satellite Basemap
          Origin X: 238.45997619628906
          Origin Y: 643.0291748046875
          Origin Yaw: 0
          Resolution: 0.25
          Value: true
      Enabled: true
      Name: Overlays
  Enabled: true
  Global Options:
    Background Color: 206; 206; 206
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /avt_341/goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
    - Class: avt_341_rviz_plugins/Set Nav Goal
      Distance Threshold: -1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: avt_341/new_waypoints
      Vehicle ID: mrzr2
      Yaw Threshold: -1
    - Class: avt_341_rviz_plugins/Set Formation
      Command Topic: avt_341/comm_messages
      Formation Message:
        Desired Speed: 5
        Distance: 0
        Follower 1 Name: ""
        Follower 2 Name: ""
        Follower 3 Name: ""
        Formation: ""
        Leader Name: MRZR
        Priority Type: QUEUE
        Receiver Name: MRZR
        Sender Name: MRZR
        TOI Regex: ^TI_
        Target Message ID: 0
        Termination Method: LEADER_ARRIVED
        X Offset: 0
        X Scale: 1
        Y Offset: 0
        Y Scale: 1
      Markers:
        MapMarker Topic: avt_341/map_marker
        MapMarkerList Topic: /avt_341/map_markers_change
        Pick Tolerance: 2
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 10
      Target Frame: mrzr/base_link
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
