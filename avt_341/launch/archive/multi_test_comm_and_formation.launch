  <node name="test_target_detection_node004" pkg="avt_341" type="test_target_detection_node" required="true" output="screen" >
    <remap from="avt_341/odometry" to="avt_341/odometry004" />
	  <remap from="avt_341/target_contacts" to="avt_341/target_contacts004" />

	  <param name="detection_range" value="50.0" />
  </node>

  <!-- Formation algorithms  -->
  <node name="formation_control_node004" pkg="avt_341" type="avt_341_formation_control_node" required="true" output="screen" >
    <remap from="avt_341/odometry" to="avt_341/odometry004"/> 
    <remap from="avt_341/follower_status" to="avt_341/follower_status004"/> 
    <remap from="avt_341/global_path" to="avt_341/global_path004"/>
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed004"/> 
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry004"/>
    <remap from="avt_341/gp_toggle" to="avt_341/gp_toggle004" />

    <param name="is_leader" value="true" />
    <param name="name" value="AGV4"/>
    <param name="follow_scale" value="3.0"/>
  </node>

  <!-- Mission management -->
  <node name="mission_manager004" pkg="avt_341" type="avt_341_mission_manager_node" required="true" output="screen">
    <remap from="avt_341/recv_comms" to="avt_341/recv_comms004" />
    <remap from="avt_341/new_waypoints" to="avt_341/new_waypoints004" />
    <remap from="avt_341/follower_status" to="avt_341/follower_status004"/>
	  <remap from="avt_341/nav_command_state" to="avt_341/nav_command_state004" />
	  <remap from="avt_341/odometry" to="avt_341/odometry004" />
    <remap from="avt_341/leader_odometry" to="avt_341/leader_odometry004"/>
    <remap from="avt_341/veh1_odometry" to="avt_341/odometry001" />
    <remap from="avt_341/veh2_odometry" to="avt_341/odometry002" />
    <remap from="avt_341/veh3_odometry" to="avt_341/odometry003" />
    <remap from="avt_341/veh4_odometry" to="avt_341/odometry004" />
	  <remap from="avt_341/target_contacts" to="avt_341/target_contacts004" />
  	<remap from="avt_341/comm_messages" to="avt_341/comm_messages004" />
	  <remap from="avt_341/state" to="avt_341/state004" />
    
    <param name="name" value="AGV4" />
    <param name="mission_definition_file" value="$(find avt_341)/config/mavs_forester_test_points.csv" />
  </node>

  <!-- Communications algorithms  -->
  <node name="comm_node004" pkg="avt_341" type="avt_341_comm_node" required="true" output="screen">
    <remap from="avt_341/comm_messages" to="avt_341/comm_messages004"/>
    <remap from="avt_341/recv_comms" to="avt_341/recv_comms004"/>

    <param name="host" value="localhost"/>
    <param name="port" value="9000"/>
    <param name="name" value="AGV4"/>
  </node>

  <!-- Lidar perception algorithms  -->
  <node name="perception_node004" pkg="avt_341" type="avt_341_perception_node" required="true" output="screen">
    <remap from="avt_341/points" to="avt_341/points004" />
    <remap from="avt_341/odometry" to="avt_341/odometry004" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid004" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid004" />

    <param name="use_elevation" value="false" />
    <param name="slope_threshold" value="2.5" />
    <param name="grid_height" value="300.0" />
    <param name="grid_width" value="300.0" />
    <param name="stitch_lidar_points" value="true"/>
    <param name="filter_highest_lidar" value="false"/>
    <param name="time_register_window" value="0.015" />
    <param name="grid_llx" value="-150.0" />
    <param name="grid_lly" value="-150.0" />
    <param name="grid_res" value="0.25" />
    <param name="overhead_clearance" value="7.0" />
    <param name="warmup_time" value="5.0" />
    <param name="use_registered" value="true" />
    <param name="display" value="$(arg display)" />
    <!-- <param name="grid_dilate" value="false"/>
    <param name="max_point_age" value="0.0"/> -->
  </node>

  <node name="vehicle_control_node004" pkg="avt_341" type="avt_341_control_node" required="true" output="screen" >
    <remap from="avt_341/cmd_vel" to="avt_341/cmd_vel004" />
    <remap from="avt_341/local_path" to="avt_341/local_path004" />
    <remap from="avt_341/odometry" to="avt_341/odometry004" />
    <remap from="avt_341/state" to="avt_341/state004" />
    <remap from="mrzr_velocity" to="mrzr_velocity004" />
    <remap from="avt_341/desired_speed" to="avt_341/desired_speed004" />
    <remap from="avt_341/control_next_waypoint" to="avt_341/control_next_waypoint004" />

    <param name="vehicle_wheelbase" value="2.72" />
    <param name="vehicle_max_steer_angle_degrees" value="35.0" />
    <param name="steering_coefficient" value="4.5" />
    <param name="throttle_coefficient" value="1.0" />
    <param name="vehicle_speed" value="5.0" />
    <param name="throttle_kp" value="0.1129" />
    <param name="throttle_ki" value="0.0" />
    <param name="throttle_kd" value="0.0435" />
    <param name="max_desired_lateral_g" value="0.25" />
    <param name="time_to_max_brake" value="4.0" />
    <param name="time_to_max_throttle" value="3.0" />
    <param name="use_feed_forward" value="true" />
    <param name="ff_a0" value="0.2134" />
    <param name="ff_a1" value="0.0422" />
    <param name="ff_a2" value="-0.0003" />
  </node>

<!--
  <node name="path_manager_node" pkg="avt_341" type="path_manager_node" required="true" output="screen">
    <param name="wait_period" value="30.0" />
  </node>
  -->

  <node name="global_path_node004" pkg="avt_341" type="avt_341_global_path_node" required="true" output="screen">
    <remap from="avt_341/global_path" to="avt_341/global_path004" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints004" />
    <remap from="avt_341/current_waypoint" to="avt_341/current_waypoint004" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/distance_to_current_waypoint004" />
    <remap from="avt_341/odometry" to="avt_341/odometry004" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid004" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid004" />
    <remap from="avt_341/new_waypoints" to="avt_341/new_waypoints004" />
    <remap from="avt_341/state" to="avt_341/state004" />
    <remap from="avt_341/gp_toggle" to="avt_341/gp_toggle004" />
	  <remap from="avt_341/nav_command_state" to="avt_341/nav_command_state004" />

    <param name="goal_dist" value="8.0" />
    <param name="global_lookahead" value="75.0" />
    <param name="shutdown_behavior" value="1" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="local_planner_node004" pkg="avt_341" type="avt_341_local_planner_node" output="screen" required="true" if="$(eval not arg('use_mpc'))">
    <remap from="avt_341/local_path" to="avt_341/local_path004" />
    <remap from="avt_341/odometry" to="avt_341/odometry004" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid004" />
    <remap from="avt_341/segmentation_grid" to="avt_341/segmentation_grid004" />
    <remap from="avt_341/global_path" to="avt_341/global_path004" />
    <remap from="avt_341/waypoints" to="avt_341/waypoints004" />
    <remap from="avt_341/candidate_paths" to="avt_341/candidate_paths004" />

    <param name="path_look_ahead" value="20.0" />
    <param name="vehicle_width" value="3.0" />
    <param name="use_global_path" value="true" />
    <param name="num_paths" value="31" />
    <param name="max_steer_angle" value="0.4" />
    <param name="output_path_step" value="0.5" />
    <param name="path_integration_step" value="0.25" />
    <param name="dilation_factor" value="3" />
    <param name="w_c" value="0.0" />
    <param name="w_s" value="0.95" />
    <param name="w_d" value="0.0" />
    <param name="w_r" value="0.05" />
    <param name="rate" value="50.0" />
    <param name="trim_path" value="true" />
    <param name="display" value="$(arg display)" />
  </node>

  <node name="mavs_vehicle_node004" pkg="mavs_ros" type="mavs_vehicle_node" output="screen" required="true" >
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel004"/> 
    <remap from= "mavs_ros/odometry" to="avt_341/odometry004" />
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true004"/>
    <remap from= "mavs_ros/anim_poses" to="mavs_ros/anim_poses004"/>  

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "debug_camera" value="false" />
    <param name= "Initial_X_Position" value = "-140.0"/>
    <param name= "Initial_Y_Position" value = "-15.0"/>
    <param name= "Initial_Heading" value = "0.0"/>
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "soil_strength" value = "250"/> 
    <param name= "surface_type" value = "dry"/>  
    <param name= "publish_imu" value="true" />
    <param name= "imu_input_file" value = "$(find mavs_ros)/config/mavs_imu_inputs.json" />
    <param name= "use_human_driver" value="false" />
    <param name= "vehicle_id" value="AGV4" />
  </node>

  <node name="mavs_sensors_node004" pkg="mavs_ros" type="mavs_sensors_node" output="screen" required="true" >
    <remap from= "mavs_ros/point_cloud2" to="avt_341/points004"/> 
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true004" />

    <param name= "use_lidar" value="true" />
    <param name= "display_lidar" value="true" />
    <param name= "register_lidar" value="true" />
    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "lidar_type" value = "OS1"/>
    <param name= "blanking_dist" value="5.0" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "num_vehicles" value="$(arg num_vehicles_arg)" />
    <param name="sensor_name" value="AGV4 Lidar" />
  </node>

  <node name="mavs_camera_node004" pkg="mavs_ros" type="mavs_camera_node" output="screen" required="true" >
    <remap from= "mavs_ros/odometry_true" to="mavs_ros/odometry_true004"/>  
    <remap from= "mavs_ros/cmd_vel" to="avt_341/cmd_vel004"/>  

    <param name= "rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name= "scene_file" value="$(arg scene_file_arg)"/>
    <param name= "display_image" value="true" />
    <param name= "num_vehicles" value="$(arg num_vehicles_arg)" />
    <param name= "off_x" value="-10.0" />
    <param name= "off_y" value="0.0" />
    <param name= "off_z" value="2.5" />
    <param name= "num_horizontal_pix" value="384" />
    <param name= "num_vertical_pix" value="256" />
    <param name= "horizontal_pixdim" value="0.00525" />
    <param name= "vertical_pixdim" value="0.0035" />
    <param name= "focal_length" value="0.0035" />
    <param name= "publish_driving_commands" value="false" />
    <param name="sensor_name" value="AGV4 Camera" />
  </node>
<!-- END VEHICLE 4 -->

  <node name="mavs_static_camera_node" pkg="mavs_ros" type="mavs_static_camera_node" output="screen" required="false" > 
    <param name="rp3d_vehicle_file" value="$(arg vehicle_file_arg)" />
    <param name="scene_file" value="$(arg scene_file_arg)"/>
    <param name="update_rate_hz" value="20.0" />
    <param name= "display_image" value="true" />
    <param name="num_vehicles" value="$(arg num_vehicles_arg)" />
    <param name="pos_x" value="-45.0" />
    <param name="pos_y" value="-20.0" />
    <param name="pos_z" value="12.5" />
    <param name="qw" value="0.7071" />
    <param name="qx" value="0.0" />
    <param name="qy" value="0.0" />
    <param name="qz" value="0.7071" />
    <param name="num_horizontal_pix" value="384" />
    <param name="num_vertical_pix" value="256" />
    <param name="horizontal_pixdim" value="0.00525" />
    <param name="vertical_pixdim" value="0.0035" />
    <param name="focal_length" value="0.0035" />
    <param name="keep_vehicles_in_frame" value="true" />
    <param name="sensor_name" value="static_camera" />
  </node>

  <group if="$(eval arg('display') == 'rviz' and arg('auto_launch_rviz'))">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find avt_341)/rviz/avt_341.rviz" />
  </group>

</launch>
