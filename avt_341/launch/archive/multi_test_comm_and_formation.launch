    <remap from="avt_341/waypoints" to="avt_341/waypoints003" />
    <remap from="avt_341/current_waypoint" to="avt_341/current_waypoint003" />
    <remap from="avt_341/distance_to_current_waypoint" to="avt_341/distance_to_current_waypoint003" />
    <remap from="avt_341/odometry" to="avt_341/odometry003" />
    <remap from="avt_341/occupancy_grid" to="avt_341/occupancy_grid003" />
