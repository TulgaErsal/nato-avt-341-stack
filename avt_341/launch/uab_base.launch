      <arg name="follower_dist_break" value="$(arg follower_dist_break)" />" />
      <arg name="follower_dot_threshold" value="$(arg follower_dot_threshold)" />" />
      <arg name="follower_dot_range" value="$(arg follower_dot_range)" />" />
      <arg name="use_leader_breadcrumbs" value="$(arg use_leader_breadcrumbs)" />" />
      <arg name="oof_threshold" value="$(arg oof_threshold)" />" />
      <arg name="oof_const_term" value="$(arg oof_const_term)" />" />
      <arg name="oof_lin_slope" value="$(arg oof_lin_slope)" />" />
      <arg name="oof_mult" value="$(arg oof_mult)" />" />
      <arg name="toi_approach_dist" value="$(arg toi_approach_dist)" />" />
      <arg name="toi_encircle_radius" value="$(arg toi_encircle_radius)" />" />
      <arg name="toi_encircle_degrees" value="$(arg toi_encircle_degrees)" />" />
      <arg name="toi_encircle_cw" value="$(arg toi_encircle_cw)" />" />
      <arg name="ot_tracking_veh" value="$(arg ot_tracking_veh)" />" />
      <arg name="ot_tracked_veh" value="$(arg ot_tracked_veh)" />" />
      <arg name="host" value="$(arg host)" />" />
      <arg name="port" value="$(arg port)" />" />
      <arg name="broadcast_over_ros" value="$(arg broadcast_over_ros)" />" />
      <arg name="verbose_comm_log" value="$(arg verbose_comm_log)" />" />
    </include>
  </group>

  <!-- Uncomment this section to use the MAVS simlator.
       Must have MAVS built and installed and the 
       mavs_avt_example catkin package built. -->
  <!--
  <include file="$(find mavs_avt_example)/launch/mavs_sim.launch">
    <arg name="cmd_vel_topic_arg" default="avt_341/cmd_vel" />
    <arg name="point_cloud_topic_arg" default="avt_341/points" />
    <arg name="odometry_topic_arg" default="avt_341/odometry" />
  </include>
  -->

</launch>