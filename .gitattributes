# Line endings: store as LF, check out as LF on all platforms
* text=auto eol=lf

# Windows batch scripts are the one place CRLF actually matters
*.bat text eol=crlf
*.cmd text eol=crlf

*.ctf filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
